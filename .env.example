# Every variable this service reads (internal/config/config.go).

# Short-lived service-to-service token secret (HS256) — deliberately not any
# end-user RS256 session token. Must match the same value every other
# service's INTERNAL_JWT_SECRET is configured with.
INTERNAL_JWT_SECRET=change-me-internal-secret

CIRCULATION_SERVICE_URL=http://circulation-service:8080
CATALOG_SERVICE_URL=http://catalog-service:8080

# ADR-009: 15 minutes, polling/cron, not event-driven.
POLL_INTERVAL=15m

LOG_LEVEL=info
